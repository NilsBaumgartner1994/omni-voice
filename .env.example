# Kopieren nach `.env` und anpassen: `cp .env.example .env`
# Alle Werte sind optional – ohne .env laufen die Standardwerte.

# --- Netzwerk ---------------------------------------------------------------
# Port auf dem Host (im Container immer 7860).
OMNIVOICE_PORT=7860

# --- Modell -----------------------------------------------------------------
# Es wird KEIN Hugging-Face-Token benötigt: k2-fsa/OmniVoice,
# eustlb/higgs-audio-v2-tokenizer und openai/whisper-* sind öffentlich.
OMNIVOICE_MODEL=k2-fsa/OmniVoice

# cpu | cuda | mps | xpu — leer lassen für Auto-Erkennung.
# Achtung: Docker Desktop auf macOS kann NICHT auf die Apple-GPU (mps) zugreifen.
OMNIVOICE_DEVICE=cpu

# float32 | float16 | bfloat16 — leer lassen für: fp32 auf CPU, fp16 auf GPU.
OMNIVOICE_DTYPE=

# --- Automatische Transkription (Whisper) -----------------------------------
# true lädt zusätzlich ein Whisper-Modell (mehrere GB), damit beim Klonen
# der Referenztext automatisch erkannt wird. Standard: aus.
OMNIVOICE_LOAD_ASR=false
# Kleinere Alternative für Laptops: openai/whisper-small
OMNIVOICE_ASR_MODEL=openai/whisper-large-v3-turbo

# --- Sonstiges --------------------------------------------------------------
# Maximale Textlänge pro Anfrage.
OMNIVOICE_MAX_TEXT_CHARS=2000
# Anzahl CPU-Threads (leer = alle Kerne).
OMP_NUM_THREADS=
# Spiegelserver, falls huggingface.co nicht erreichbar ist.
# HF_ENDPOINT=https://hf-mirror.com
# Nach `make prefetch` auf 1 setzen für kompletten Offline-Betrieb.
# HF_HUB_OFFLINE=1
# 'dummy' erzeugt nur einen Testton (Smoke-Test ohne Modell-Download).
OMNIVOICE_ENGINE=omnivoice
