# Standardkonfiguration von OmniVoice.
#
# Diese Datei ist eingecheckt und enthaelt genau die Werte, mit denen das
# Projekt ohne weiteres Zutun startet. Einfach hier anpassen -- oder die Zeile
# leeren, dann greift der Standard aus der docker-compose.yml.
# Es wird KEIN Hugging-Face-Token benoetigt.

# --- Netzwerk ---------------------------------------------------------------
# Port auf dem Host (im Container immer 7860).
OMNIVOICE_PORT=7860

# --- Modell -----------------------------------------------------------------
# k2-fsa/OmniVoice, eustlb/higgs-audio-v2-tokenizer und openai/whisper-* sind
# oeffentlich und werden anonym geladen.
OMNIVOICE_MODEL=k2-fsa/OmniVoice

# cpu | cuda | mps | xpu -- leer lassen fuer Auto-Erkennung.
# Achtung: Docker Desktop auf macOS kann NICHT auf die Apple-GPU (mps) zugreifen.
OMNIVOICE_DEVICE=cpu

# float32 | float16 | bfloat16 -- leer = fp32 auf CPU, fp16 auf GPU.
OMNIVOICE_DTYPE=

# 'dummy' erzeugt nur einen Testton (Smoke-Test ohne Modell-Download).
OMNIVOICE_ENGINE=omnivoice

# --- Automatische Transkription (Whisper) -----------------------------------
# true laedt zusaetzlich ein Whisper-Modell (mehrere GB), damit beim Klonen
# der Referenztext automatisch erkannt wird. Standard: aus.
OMNIVOICE_LOAD_ASR=false
# Kleinere Alternative fuer Laptops: openai/whisper-small
OMNIVOICE_ASR_MODEL=openai/whisper-large-v3-turbo

# --- Ordner -----------------------------------------------------------------
# Beide Ordner liegen im Repository. Absolute Pfade gehen genauso, z. B. eine
# externe Platte: OMNIVOICE_MODELS_PATH=/Volumes/Extern/omnivoice-models
# Modellgewichte (mehrere GB).
OMNIVOICE_MODELS_PATH=./models
# Stimm-Bibliothek: Personen, Bilder, Referenzaufnahmen, Referenztexte.
OMNIVOICE_DATA_PATH=./data
# Verzeichnis im Container (normalerweise unveraendert lassen).
OMNIVOICE_LIBRARY_DIR=/data/voices
# Obergrenze fuer hinterlegte Bilder.
# OMNIVOICE_MAX_IMAGE_BYTES=5242880
# Wie viele berechnete Stimmen gleichzeitig im Arbeitsspeicher bleiben.
# OMNIVOICE_VOICE_CACHE_SIZE=8

# --- Sonstiges --------------------------------------------------------------
# Maximale Textlaenge pro Anfrage.
OMNIVOICE_MAX_TEXT_CHARS=2000
# Gemessene Laufzeiten fuer die Dauerprognose in der Weboberflaeche.
# Standard liegt im Modell-Ordner und ueberlebt damit einen Neustart.
# OMNIVOICE_TIMING_HISTORY=/models/generation-timings.json
# OMNIVOICE_TIMING_HISTORY_SIZE=200
# Anzahl CPU-Threads (leer = alle Kerne).
OMP_NUM_THREADS=
# Spiegelserver, falls huggingface.co nicht erreichbar ist. Muss eine
# vollstaendige URL mit Schema sein -- sonst die Zeile ganz weglassen.
HF_ENDPOINT=https://huggingface.co
# Nach `make prefetch` auf 1 setzen fuer kompletten Offline-Betrieb.
HF_HUB_OFFLINE=
